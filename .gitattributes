src/clientversion.cpp export-subst

# Keep shell/build scripts LF so Linux/macOS CI can execute them (exit 126 on CRLF).
*.sh text eol=lf
autogen.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Patches must be LF or hunks fail against Unix source trees.
*.patch text eol=lf
# Autoconf helpers must be LF or configure cannot exec them on macOS/Linux.
depends/config.guess text eol=lf
depends/config.sub text eol=lf
depends/Makefile text eol=lf
depends/**/*.mk text eol=lf
depends/**/*.in text eol=lf
